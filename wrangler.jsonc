{
  "name": "fouad-education-campaign",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-05-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"],
  },
  "vars": { "PAYUNIT_MODE": "test" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fouad_campaign_db",
      "database_id": "REPLACE_WITH_YOUR_NEW_CAMPAIGN_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "fouad-campaign-media" },
  ],
}
